Bundle-SymbolicName:    io.klib.bootstrap.core
Bundle-Name:            io.klib Bootstrap Core
Bundle-Description:     OSGi DS component implementations of the bootstrap services.

# Only the impl package stays inside the bundle (not exported)
Private-Package: io.klib.bootstrap.core

-buildpath: \
	io.klib.bootstrap.api;version=project, \
	osgi.annotation;version=latest, \
	org.osgi.service.component.annotations;version=latest, \
	org.osgi.service.component;version=latest

-testpath: \
	junit-jupiter-api;version='[5.11,6)', \
	junit-jupiter-engine;version='[5.11,6)', \
	junit-platform-commons;version='[1.11,2)', \
	junit-platform-engine;version='[1.11,2)', \
	junit-platform-launcher;version='[1.11,2)', \
	junit-jupiter-params;version='[5.11,6)', \
	org.opentest4j;version='[1.3,2)'
