# ──────────────────────────────────────────────────────────────────
#  debug.bndrun — OSGi application in verbose debug mode
#
#  Run with: ./gradlew :io.klib.bootstrap.app:run -Pbndrun=debug.bndrun
#         or: bnd run io.klib.bootstrap.app/debug.bndrun
# ──────────────────────────────────────────────────────────────────

# Inherit all settings from the main launcher
-include: launch.bndrun

# Add Felix Gogo interactive shell for runtime inspection
-runbundles.debug: \
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)', \
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)', \
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)'

# Verbose bnd run tracing
-runtrace: true
